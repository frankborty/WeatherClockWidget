<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_mask"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/widget_background_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_border"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        tools:ignore="NestedWeights">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_condition_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/widget_weather_icon_description"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_weather_sun" />

            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_temperature_placeholder"
                android:textColor="@color/widget_text_primary"
                android:textSize="26sp"
                tools:text="15°" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_date_placeholder"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        tools:text="Martedì 3 Novembre" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_location_placeholder"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            tools:text="Roma" />

        <TextView
            android:id="@+id/widget_min_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_min_max_placeholder"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            tools:text="↓17° ↑19°" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_hourly_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_hourly_background"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/widget_hour_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_hour_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_hour_time_placeholder"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                tools:text="19:00" />

            <ImageView
                android:id="@+id/widget_hour_icon_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@string/widget_weather_icon_description"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_weather_sun" />

            <TextView
                android:id="@+id/widget_hour_temp_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/widget_hour_temp_placeholder"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                tools:text="14°" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_hour_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_hour_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_hour_time_placeholder"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                tools:text="20:00" />

            <ImageView
                android:id="@+id/widget_hour_icon_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@string/widget_weather_icon_description"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_weather_cloudy" />

            <TextView
                android:id="@+id/widget_hour_temp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/widget_hour_temp_placeholder"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                tools:text="13°" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_hour_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_hour_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_hour_time_placeholder"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                tools:text="21:00" />

            <ImageView
                android:id="@+id/widget_hour_icon_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@string/widget_weather_icon_description"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_weather_partly_cloudy_night" />

            <TextView
                android:id="@+id/widget_hour_temp_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/widget_hour_temp_placeholder"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                tools:text="12°" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_hour_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_hour_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_hour_time_placeholder"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                tools:text="22:00" />

            <ImageView
                android:id="@+id/widget_hour_icon_4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@string/widget_weather_icon_description"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_weather_partly_cloudy_day" />

            <TextView
                android:id="@+id/widget_hour_temp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/widget_hour_temp_placeholder"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                tools:text="11°" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_hour_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_hour_time_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_hour_time_placeholder"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                tools:text="23:00" />

            <ImageView
                android:id="@+id/widget_hour_icon_5"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@string/widget_weather_icon_description"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_weather_moon" />

            <TextView
                android:id="@+id/widget_hour_temp_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/widget_hour_temp_placeholder"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                tools:text="10°" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
