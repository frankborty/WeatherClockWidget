<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_mask"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/widget_background_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_border"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        tools:ignore="NestedWeights">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/widget_clock"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="64sp"
                    android:autoSizeMinTextSize="28sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_date_placeholder"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="15sp"
                    tools:text="Martedì 3 Novembre" />

                <TextView
                    android:id="@+id/widget_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="@string/widget_location_placeholder"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    tools:text="Roma" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_condition_icon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="@string/widget_weather_icon_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_weather_partly_cloudy_day" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="start"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_temperature_placeholder"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="46sp"
                        tools:text="15°" />

                    <TextView
                        android:id="@+id/widget_min_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginStart="3dp"
                        android:layout_marginTop="2dp"
                        android:gravity="start"
                        android:maxLines="1"
                        android:text="@string/widget_min_max_placeholder"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="13sp"
                        tools:text="↓17° ↑19°" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_xl_hourly_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_hourly_background"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/widget_hour_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hour_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_hour_time_placeholder"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_hour_icon_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="@string/widget_weather_icon_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_weather_sun" />

                <TextView
                    android:id="@+id/widget_hour_temp_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_hour_temp_placeholder"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hour_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hour_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_hour_time_placeholder"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_hour_icon_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="@string/widget_weather_icon_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_weather_cloudy" />

                <TextView
                    android:id="@+id/widget_hour_temp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_hour_temp_placeholder"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hour_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hour_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_hour_time_placeholder"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_hour_icon_3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="@string/widget_weather_icon_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_weather_partly_cloudy_night" />

                <TextView
                    android:id="@+id/widget_hour_temp_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_hour_temp_placeholder"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hour_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hour_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_hour_time_placeholder"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_hour_icon_4"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="@string/widget_weather_icon_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_weather_partly_cloudy_day" />

                <TextView
                    android:id="@+id/widget_hour_temp_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_hour_temp_placeholder"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hour_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hour_time_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_hour_time_placeholder"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_hour_icon_5"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="@string/widget_weather_icon_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_weather_moon" />

                <TextView
                    android:id="@+id/widget_hour_temp_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_hour_temp_placeholder"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hour_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hour_time_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_hour_time_placeholder"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_hour_icon_6"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="@string/widget_weather_icon_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_weather_cloudy" />

                <TextView
                    android:id="@+id/widget_hour_temp_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_hour_temp_placeholder"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hour_7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hour_time_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_hour_time_placeholder"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_hour_icon_7"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="@string/widget_weather_icon_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_weather_cloudy" />

                <TextView
                    android:id="@+id/widget_hour_temp_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_hour_temp_placeholder"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hour_8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hour_time_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_hour_time_placeholder"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_hour_icon_8"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:contentDescription="@string/widget_weather_icon_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_weather_cloudy" />

                <TextView
                    android:id="@+id/widget_hour_temp_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_hour_temp_placeholder"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
